<?xml version="1.0" encoding="utf-8"?>
<!-- A sick day on the week strip: a short dash, so it does not read as a missed day -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="5.5dp" android:insetBottom="5.5dp">
    <shape android:shape="rectangle">
        <solid android:color="#FFFFFFFF" />
        <corners android:radius="2dp" />
    </shape>
</inset>
