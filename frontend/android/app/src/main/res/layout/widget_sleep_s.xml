<?xml version="1.0" encoding="utf-8"?>
<!-- A home-screen widget layout. Colours and text are set in code: see docs/widgets_plan.md -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_card_base" android:foreground="@drawable/w_ripple_card"
    android:clipToOutline="true">
<include layout="@layout/w_card_bg" />
<LinearLayout android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
<FrameLayout android:id="@+id/s_btn" android:layout_width="match_parent" android:layout_height="match_parent" android:foreground="@drawable/w_ripple_round" android:contentDescription="Start the sleep timer">
<ImageView android:id="@+id/s_btn_bg" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_round" android:scaleType="fitXY" android:tint="@color/widget_tile" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp">
<ImageView style="@style/WIcon" android:id="@+id/s_btn_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/w_ic_play" android:tint="@color/widget_text" />
<TextView style="@style/WText.Button" android:id="@+id/s_btn_label" android:text="Going to sleep" android:layout_marginTop="6dp" />
<Chronometer style="@style/WText.Secondary" android:id="@+id/s_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="4dp" android:textColor="@color/widget_on_brand" />
<TextView style="@style/WText.Caption" android:id="@+id/s_sub" android:text="Last night 7h 12min" android:layout_marginTop="3dp" android:maxLines="3" android:gravity="center" />
</LinearLayout>
</FrameLayout>
</LinearLayout>
</FrameLayout>
