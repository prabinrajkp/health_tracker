<?xml version="1.0" encoding="utf-8"?>
<!-- A home-screen widget layout. Colours and text are set in code: see docs/widgets_plan.md -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_card_base" android:foreground="@drawable/w_ripple_card"
    android:clipToOutline="true">
<include layout="@layout/w_card_bg" />
<LinearLayout android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/t_scorebox" android:gravity="bottom">
<TextView style="@style/WText.Hero" android:id="@+id/t_score" android:text="72" />
<TextView style="@style/WText.Caption" android:id="@+id/t_outof" android:text="/ 100" android:layout_marginStart="4dp" android:layout_marginBottom="3dp" />
</LinearLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
<RelativeLayout android:id="@+id/t_chip_frame" android:layout_width="wrap_content" android:layout_height="wrap_content">
<ImageView android:id="@+id/t_chip_bg" android:layout_width="0dp" android:layout_height="0dp"
    android:layout_alignStart="@+id/t_chip" android:layout_alignEnd="@+id/t_chip"
    android:layout_alignTop="@+id/t_chip" android:layout_alignBottom="@+id/t_chip"
    android:src="@drawable/w_pill" android:scaleType="fitXY" android:tint="@color/widget_brand_tint" android:importantForAccessibility="no" />
<TextView android:id="@+id/t_chip" style="@style/WText.Heading" android:textSize="13sp" android:textColor="@color/widget_brand"
    android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="B · Great" />
</RelativeLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/t_msg_box" android:visibility="gone" android:layout_marginTop="8dp">
<ImageView style="@style/WIcon" android:id="@+id/t_msg_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/w_ic_sick" android:tint="@color/widget_text2" />
<TextView style="@style/WText.Heading" android:id="@+id/t_msg_title" android:text="Sick day" android:textSize="16sp" android:layout_marginTop="8dp" android:maxLines="2" />
<TextView style="@style/WText.Secondary" android:id="@+id/t_msg_body" android:text="Rest up. Nothing to log today." android:maxLines="3" android:layout_marginTop="4dp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/t_bars" android:layout_marginTop="4dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/t_row_diet" android:gravity="center_vertical" android:layout_marginTop="7dp">
<TextView style="@style/WText.Secondary" android:id="@+id/t_lbl_diet" android:text="Diet" android:layout_width="64dp" />
<FrameLayout android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1">
<ImageView android:id="@+id/t_bar_diet_track" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_pill" android:scaleType="fitXY" android:tint="@color/widget_tile" android:importantForAccessibility="no" />
<ImageView android:id="@+id/t_bar_diet_fill" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_bar_fill_69" android:scaleType="fitXY" android:tint="@color/widget_diet" android:importantForAccessibility="no" />
</FrameLayout>
<TextView style="@style/WText.Body" android:id="@+id/t_val_diet" android:text="24" android:textSize="13sp" android:layout_marginStart="10dp" android:layout_width="24dp" android:gravity="end" />
<TextView style="@style/WText.Caption" android:id="@+id/t_max_diet" android:text="/35" android:layout_width="24dp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/t_row_fasting" android:gravity="center_vertical" android:layout_marginTop="7dp">
<TextView style="@style/WText.Secondary" android:id="@+id/t_lbl_fasting" android:text="Fasting" android:layout_width="64dp" />
<FrameLayout android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1">
<ImageView android:id="@+id/t_bar_fasting_track" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_pill" android:scaleType="fitXY" android:tint="@color/widget_tile" android:importantForAccessibility="no" />
<ImageView android:id="@+id/t_bar_fasting_fill" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_bar_fill_60" android:scaleType="fitXY" android:tint="@color/widget_fasting" android:importantForAccessibility="no" />
</FrameLayout>
<TextView style="@style/WText.Body" android:id="@+id/t_val_fasting" android:text="6" android:textSize="13sp" android:layout_marginStart="10dp" android:layout_width="24dp" android:gravity="end" />
<TextView style="@style/WText.Caption" android:id="@+id/t_max_fasting" android:text="/10" android:layout_width="24dp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/t_row_workout" android:gravity="center_vertical" android:layout_marginTop="7dp">
<TextView style="@style/WText.Secondary" android:id="@+id/t_lbl_workout" android:text="Workout" android:layout_width="64dp" />
<FrameLayout android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1">
<ImageView android:id="@+id/t_bar_workout_track" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_pill" android:scaleType="fitXY" android:tint="@color/widget_tile" android:importantForAccessibility="no" />
<ImageView android:id="@+id/t_bar_workout_fill" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_bar_fill_43" android:scaleType="fitXY" android:tint="@color/widget_workout" android:importantForAccessibility="no" />
</FrameLayout>
<TextView style="@style/WText.Body" android:id="@+id/t_val_workout" android:text="15" android:textSize="13sp" android:layout_marginStart="10dp" android:layout_width="24dp" android:gravity="end" />
<TextView style="@style/WText.Caption" android:id="@+id/t_max_workout" android:text="/35" android:layout_width="24dp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/t_row_sleep" android:gravity="center_vertical" android:layout_marginTop="7dp">
<TextView style="@style/WText.Secondary" android:id="@+id/t_lbl_sleep" android:text="Sleep" android:layout_width="64dp" />
<FrameLayout android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1">
<ImageView android:id="@+id/t_bar_sleep_track" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_pill" android:scaleType="fitXY" android:tint="@color/widget_tile" android:importantForAccessibility="no" />
<ImageView android:id="@+id/t_bar_sleep_fill" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/w_bar_fill_90" android:scaleType="fitXY" android:tint="@color/widget_sleep" android:importantForAccessibility="no" />
</FrameLayout>
<TextView style="@style/WText.Body" android:id="@+id/t_val_sleep" android:text="27" android:textSize="13sp" android:layout_marginStart="10dp" android:layout_width="24dp" android:gravity="end" />
<TextView style="@style/WText.Caption" android:id="@+id/t_max_sleep" android:text="/30" android:layout_width="24dp" />
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/t_next_box" android:foreground="@drawable/w_ripple_round">
<TextView style="@style/WText.Label" android:id="@+id/t_next_label" android:text="Next" android:textColor="@color/widget_brand" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="3dp">
<TextView style="@style/WText.Heading" android:id="@+id/t_next_title" android:text="Log lunch" android:layout_width="0dp" android:layout_weight="1" android:maxLines="2" />
<ImageView style="@style/WIcon" android:id="@+id/t_next_chev" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/w_ic_chevron" android:tint="@color/widget_muted" android:layout_marginStart="4dp" />
</LinearLayout>
<TextView style="@style/WText.Secondary" android:id="@+id/t_next_sub" android:text="Worth 8 pts" android:layout_marginTop="3dp" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
